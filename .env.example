# --- Runtime ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# --- Secrets loading (scripts/start_with_secrets.py) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5443/rag

# --- Admin ---
ADMIN_API_KEY=change-me-to-a-long-random-admin-key-32-chars-min

# --- Storage (StorageProvider): local | s3 ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/uploads
S3_BUCKET=

# --- Embeddings (EmbeddingProvider): fake | bedrock ---
EMBEDDING_PROVIDER=fake
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# --- LLM (LLMProvider): fake | anthropic | bedrock ---
LLM_PROVIDER=fake
# anthropic: credentials come from ANTHROPIC_API_KEY (or an `ant auth login` profile).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
BEDROCK_LLM_MODEL=anthropic.claude-opus-5-5
BEDROCK_FALLBACK_MODEL=anthropic.claude-opus-4-8
LLM_EFFORT=medium
LLM_MAX_TOKENS=64000
# Prices used for the estimated cost of each query. Set them from your provider's price list.
LLM_INPUT_USD_PER_MTOK=0
LLM_OUTPUT_USD_PER_MTOK=0

# --- Ingestion and retrieval ---
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
MAX_UPLOAD_BYTES=2000000
DEFAULT_TOP_K=5
DEFAULT_MONTHLY_QUERY_LIMIT=1000
